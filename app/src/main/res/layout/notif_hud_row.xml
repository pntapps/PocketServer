<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the expanded server notification: ▸ NAME over its address, uptime on the right.
     Stacked so the name is never squeezed out on phones or with large text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="▸"
        android:textColor="#FF3FE0FF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed-medium"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="#FFD8F6FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="#FF3FE0FF"
            android:textSize="12sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/uptime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:gravity="end"
        android:textColor="#FF7FA3B8"
        android:textSize="12sp" />
</LinearLayout>
